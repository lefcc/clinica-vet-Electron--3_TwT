# Banco de dados local (SQLite) - caminho relativo à pasta de dados do usuário (app.getPath('userData'))
# Não definir aqui - gerado automaticamente pelo Electron

# Banco de dados central (MySQL) - desenvolvimento via docker-compose
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=clinica
MYSQL_PASSWORD=clinica123
MYSQL_DATABASE=clinica_vet
MYSQL_SSL=false

# Sincronização
SYNC_INTERVAL_MS=300000
SYNC_BATCH_SIZE=100

# AwesomeAPI (cotação dólar)
DOLAR_API_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL
DOLAR_FETCH_INTERVAL_MS=3600000

# Segurança
BCRYPT_COST=10
SESSION_TTL_HOURS=8

# Electron
NODE_ENV=development