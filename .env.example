# Banco de dados local (SQLite) - caminho relativo à pasta de dados do usuário (app.getPath('userData'))
# Não definir aqui - gerado automaticamente pelo Electron

# Banco de dados central (MySQL) - desenvolvimento via docker-compose
MYSQL_HOST=143.106.241.4
MYSQL_PORT=3306
MYSQL_USER=cl205092
MYSQL_PASSWORD=cl*08042009
MYSQL_DATABASE=cl205092
MYSQL_SSL=true

# Sincronização
SYNC_HABILITADO=false
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=100

# AwesomeAPI (cotação dólar)
DOLAR_API_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL
DOLAR_FETCH_INTERVAL_MS=3600000

# Segurança
BCRYPT_COST=10
SESSION_TTL_HOURS=8

# Usuário inicial (login). Opcional: sem isso, em desenvolvimento vale o usuário de exemplo
# que está em app/src/main/db/local/seed-usuario-exemplo.ts. Em produção, defina aqui.
# SEED_MASTER_LOGIN=master
# SEED_MASTER_SENHA=defina-uma-senha-com-8-ou-mais-caracteres
# SEED_MASTER_NOME=Administrador
# SEED_MASTER_CPF=00000000000

# Electron
NODE_ENV=development
